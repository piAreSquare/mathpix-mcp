#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'

# Load environment (incl. MATHPIX_* and MATHPIX_MCP_TOKEN) from .env if present.
begin
  require 'dotenv/load'
rescue LoadError
  # dotenv not installed — rely on the process environment
end

require 'rack'
require 'mathpix'
require 'mathpix/mcp'
require 'mathpix/mcp/http_app'
require 'mathpix/mcp/upload_ticket'
require 'mathpix/mcp/ocr_app'

Mathpix.configure do |config|
  config.app_id = ENV.fetch('MATHPIX_APP_ID', nil)
  config.app_key = ENV.fetch('MATHPIX_APP_KEY', nil)
  config.max_file_size_mb = ENV['MATHPIX_MAX_FILE_SIZE_MB']&.to_i || 10
  config.enforce_https = ENV['MATHPIX_HTTPS_ONLY'] != 'false'
end

token = ENV.fetch('MATHPIX_MCP_TOKEN', nil)
if token.nil? || token.empty?
  abort 'MATHPIX_MCP_TOKEN must be set to run the HTTP transport (bearer-token auth is required)'
end

# /ocr accepts a document upload and forwards it to Mathpix; / remains the MCP
# Streamable HTTP transport, unchanged. /ocr takes the bearer token OR a signed
# single-use ticket minted over the MCP channel, so a caller can upload without
# ever holding the long-lived token.
app = Rack::URLMap.new(
  '/ocr' => Mathpix::MCP::OcrApp.guarded(token: token),
  '/' => Mathpix::MCP::HttpApp.build(token: token)
)

host = ENV.fetch('MATHPIX_MCP_HOST', '127.0.0.1')
# MATHPIX_MCP_PORT still wins, so existing deployments bind exactly as before;
# PORT is honoured only as a fallback for platforms that inject it (Railway,
# Heroku, Fly) when MATHPIX_MCP_PORT has not been set.
port = Integer(ENV['MATHPIX_MCP_PORT'] || ENV['PORT'] || '3000')

require 'puma'
require 'puma/configuration'
require 'puma/launcher'

configuration = Puma::Configuration.new do |c|
  c.app(app)
  c.bind("tcp://#{host}:#{port}")
  c.log_requests(false)
  # Uploads are streamed to disk and forwarded to Mathpix; the default 60s
  # first-byte timeout is too tight for a large document on a slow link.
  c.first_data_timeout(120)
  c.persistent_timeout(120)
end

warn "Mathpix MCP (Streamable HTTP + /ocr) listening on http://#{host}:#{port}"
Puma::Launcher.new(configuration).run
